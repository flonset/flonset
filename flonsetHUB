-- Функция для добавления элементов управления внутрь ESP секции
local function createToggleWithColor(name, defaultColor, callback)
    local ItemFrame = Instance.new("Frame")
    ItemFrame.Size = UDim2.new(1, 0, 0, 32)
    ItemFrame.BackgroundTransparency = 1
    ItemFrame.Parent = EspContainer
    
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0.7, 0, 1, 0)
    ToggleBtn.Position = UDim2.new(0, 5, 0, 0)
    ToggleBtn.BackgroundTransparency = 1
    ToggleBtn.Font = Enum.Font.GothamSemibold
    ToggleBtn.Text = "  [ ] " .. name
    ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    ToggleBtn.TextSize = 12
    ToggleBtn.TextXAlignment = Enum.TextXAlignment.Left
    ToggleBtn.Parent = ItemFrame
    
    -- Простейший выбор цвета (цветной квадратик справа)
    local ColorBtn = Instance.new("TextButton")
    ColorBtn.Size = UDim2.new(0, 24, 0, 20)
    ColorBtn.Position = UDim2.new(1, -34, 0.5, -10)
    ColorBtn.BackgroundColor3 = defaultColor
    ColorBtn.Text = ""
    ColorBtn.Parent = ItemFrame
    
    local ColorCorner = Instance.new("UICorner")
    ColorCorner.CornerRadius = UDim.new(0, 4)
    ColorCorner.Parent = ColorBtn
    
    local enabled = false
    ToggleBtn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            ToggleBtn.Text = "  [✓] " .. name
            ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        else
            ToggleBtn.Text = "  [ ] " .. name
            ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        callback(enabled, ColorBtn.BackgroundColor3)
    end)
end

