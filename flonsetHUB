-- 1. Визуалы (ESP)
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local character = player.Character
            if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                
                -- Chams
                local highlight = character:FindFirstChild("BS_Chams")
                if BS_Settings.Chams then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "BS_Chams"
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Adornee = character
                        highlight.Parent = character
                    end
                    highlight.FillColor = BS_Settings.ChamsColor
                else
                    if highlight then highlight:Destroy() end
                end
                
                -- Box & Info
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local billboard = rootPart:FindFirstChild("BS_ESP_Info")
                    if BS_Settings.Boxes or BS_Settings.HP or BS_Settings.Nickname then
                        if not billboard then
                            billboard = Instance.new("BillboardGui")
                            billboard.Name = "BS_ESP_Info"
                            billboard.Size = UDim2.new(4, 0, 5, 0)
                            billboard.AlwaysOnTop = true
                            billboard.Adornee = rootPart
                            
                            local frame = Instance.new("Frame")
                            frame.Name = "BoxFrame"
                            frame.Size = UDim2.new(1, 0, 1, 0)
                            frame.BackgroundTransparency = 1
                            frame.Parent = billboard
                            
                            local stroke = Instance.new("UIStroke")
                            stroke.Name = "BoxStroke"
                            stroke.Thickness = 1.5
                            stroke.Parent = frame
                            
                            local infoText = Instance.new("TextLabel")
                            infoText.Name = "InfoText"
                            infoText.Size = UDim2.new(1, 0, 0, 40)
                            infoText.Position = UDim2.new(0, 0, 0, -42)
                            infoText.BackgroundTransparency = 1
                            infoText.Font = Enum.Font.GothamBold
                            infoText.TextSize = 11
                            infoText.TextStrokeTransparency = 0.5
                            infoText.Parent = billboard
                            
                            billboard.Parent = rootPart
                        end
                        
                        local frame = billboard:FindFirstChild("BoxFrame")
                        if frame then
                            local stroke = frame:FindFirstChild("BoxStroke")
                            if stroke then
                                stroke.Enabled = BS_Settings.Boxes
                                stroke.Color = BS_Settings.BoxesColor
                            end
                        end
                        
                        local infoText = billboard:FindFirstChild("InfoText")
                        if infoText then
                            local textParts = {}
                            if BS_Settings.Nickname then table.insert(textParts, player.Name) end
                            if BS_Settings.HP then table.insert(textParts, "[" .. math.floor(character.Humanoid.Health) .. " HP]") end
                            infoText.Text = table.concat(textParts, " ")
                            infoText.TextColor3 = BS_Settings.NickColor
                        end
                    else
                        if billboard then billboard:Destroy() end
                    end
                end
                
            end
        end
    end
end)

-- 2. Аимбот (Наводка при зажатой ПКМ)
local function getClosestEnemy()
    local closest = nil
    local shortestDistance = BS_Settings.AimFov
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local headPos, onScreen = Camera:WorldToViewportPoint(char.Head.Position)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local dist = (Vector2.new(headPos.X, headPos.Y) - mousePos).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closest = char.Head
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if BS_Settings.AimbotEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local targetHead = getClosestEnemy()
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)

-- 3. Auto BHop (Прыжки)
RunService.RenderStepped:Connect(function()
    if BS_Settings.BHopEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        local char = localPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            if char.Humanoid.FloorMaterial ~= Enum.Material.Air then
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

