local Fatality = loadstring(game:HttpGet("https://raw.githubusercontent.com/4lpaca-pin/Fatality/refs/heads/main/src/source.luau"))();
local Notification = Fatality:CreateNotifier();

Fatality:Loader({
    Name = "FATALITY",
    Duration = 3
});

Notification:Notify({
    Title = "BLOCK STRIKE",
    Content = "welcome back, "..game.Players.LocalPlayer.DisplayName,
    Icon = "target"
})

local Window = Fatality.new({
    Name = "FATALITY | BS",
    Expire = "never",
});

local Rage = Window:AddMenu({Name = "RAGE", Icon = "skull"})
local Legit = Window:AddMenu({Name = "LEGIT", Icon = "crosshair"})
local Visual = Window:AddMenu({Name = "VISUAL", Icon = "eye"})
local Misc = Window:AddMenu({Name = "MISC", Icon = "settings"})

-- === RAGE SECTION ===
do
    local Weapon = Rage:AddSection({Position = 'left', Name = "WEAPON"});
    local General = Rage:AddSection({Position = 'right', Name = "GENERAL"});

    Weapon:AddSlider({Name = "Min-damage", Type = "%", Default = 85})
    Weapon:AddDropdown({Name = "Hitboxes", Values = {"Head", "Neck", "Chest"}, Default = "Head"})
    
    General:AddToggle({Name = "Silent Aim", Risky = true, Option = false})
    General:AddSlider({Name = "FOV", Type = " deg", Default = 180})
    General:AddKeybind({Name = "Force Key", Default = Enum.KeyCode.Mouse2})
end

-- === LEGIT SECTION ===
do
    local Aim = Legit:AddSection({Position = 'left', Name = "AIM"});
    local Rcs = Legit:AddSection({Position = 'center', Name = "RCS"});
    local Trigger = Legit:AddSection({Position = 'right', Name = "TRIGGER"});

    Aim:AddToggle({Name = "Enabled", Option = false})
    Aim:AddSlider({Name = "FOV", Default = 5, Type = " deg"})
    Aim:AddSlider({Name = "Smooth", Default = 5, Type = "%"})
    Aim:AddDropdown({Name = "Hitbox", Values = {"Head", "Neck"}, Default = "Head"})

    Rcs:AddToggle({Name = "Enabled", Option = true})
    Rcs:AddSlider({Name = "Strength X", Default = 100, Type = "%"})
    Rcs:AddSlider({Name = "Strength Y", Default = 100, Type = "%"})

    Trigger:AddToggle({Name = "Enabled", Option = false})
    Trigger:AddSlider({Name = "Delay", Default = 0, Type = "ms"})
end

-- === VISUAL SECTION ===
do
    local ESP = Visual:AddSection({Position = 'left', Name = "ESP"});
    local World = Visual:AddSection({Position = 'right', Name = "WORLD"});

    ESP:AddToggle({Name = "Box ESP", Option = true}).Option:AddColorPicker({Name = "Visible", Default = Color3.fromRGB(0, 255, 0)})
    ESP:AddToggle({Name = "Name ESP", Option = true})
    ESP:AddToggle({Name = "Health Bar", Option = true})

    World:AddToggle({Name = "Thirdperson", Option = false}).Option:AddSlider({Name = "Distance", Default = 10})
    World:AddToggle({Name = "No Scope Overlay", Option = false})
end

-- === MISC SECTION ===
do
    local Extra = Misc:AddSection({Position = 'left', Name = "EXTRA"});
    
    Extra:AddToggle({Name = "Bunnyhop", Option = false})
    Extra:AddButton({
        Name = "Copy Server IP",
        Callback = function()
            setclipboard("127.0.0.1") -- заглушка, в роблоксе ip скрыт
            Notification:Notify({Title = "Misc", Content = "copied", Icon = "info"})
        end
    })
end
