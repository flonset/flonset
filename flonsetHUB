-- пример элемента (тоггл)
local function AddToggle(parent, name)
    local ToggleFrame = Instance.new("Frame", parent)
    ToggleFrame.Size = UDim2.new(1, -20, 0, 30)
    ToggleFrame.BackgroundTransparency = 0.8
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    ToggleFrame.BorderSizePixel = 0
    
    local Label = Instance.new("TextLabel", ToggleFrame)
    Label.Size = UDim2.new(1, -40, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local Box = Instance.new("Frame", ToggleFrame)
    Box.Size = UDim2.new(0, 20, 0, 20)
    Box.Position = UDim2.new(1, -30, 0.5, -10)
    Box.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    Box.BorderSizePixel = 0
    
    ToggleFrame.MouseButton1Click:Connect(function()
        -- логика переключения
        Box.BackgroundColor3 = Box.BackgroundColor3 == Color3.fromRGB(100, 100, 100) and Color3.fromRGB(255, 34, 75) or Color3.fromRGB(100, 100, 100)
    end)
end

-- добавляем тестовые элементы
AddToggle(RageTab, "Silent Aim")
