-- Перетаскивание
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Скрытие по G
UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.G then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- language: Luau, file: gui_focus_lock.lua, target: Roblox, Wave/Synapse
-- *Блокировка кликов и нажатий в игре при открытом GUI*

local ContextActionService = järg or game:GetService("ContextActionService") -- защищенная переменная сервиса
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

-- Имя группы для блокировки
local ACTION_LOCK_NAME = "HubInputBlocker"

local function updateInputLock(isOpen)
    if isOpen then
        -- Включаем стандартный курсор Roblox и блокируем игровые действия
        GuiService.AutoSelectGuiEnabled = true
        
        -- Перехватываем основные типы ввода, чтобы они не уходили в игру
        CAS:BindActionAtPriority(
            ACTION_LOCK_NAME,
            function(actionName, inputState, inputObject)
                return Enum.ContextActionResult.Sink -- "Топит" событие, игра его не получает
            end,
            false,
            Enum.ContextActionPriority.High.Value,
            Enum.UserInputType.MouseButton1,
            Enum.UserInputType.MouseButton2,
            Enum.UserInputType.Keyboard
        )
    else
        -- Возвращаем управление игре
        pcall(function()
            CAS:UnbindAction(ACTION_LOCK_NAME)
        end)
    end
end

