-- === ESP LOGIC CORE ===
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")

local ESP_Settings = {
    Enabled = false,
    ShowNames = true,
    ShowHealth = true,
    Color = Color3.fromRGB(255, 34, 75),
    Objects = {}
}

-- функция отрисовки
local function DrawESP(Player)
    if not ESP_Settings.Enabled or Player == LocalPlayer or not Player.Character then return end
    
    local Head = Player.Character:FindFirstChild("Head")
    if not Head then return end

    local Pos, OnScreen = Camera:WorldToViewportPoint(Head.Position)
    if not OnScreen then return end

    -- удаляем старые объекты этого игрока
    if ESP_Settings.Objects[Player] then
        for _, obj in pairs(ESP_Settings.Objects[Player]) do pcall(function() obj:Remove() end) end
    end
    ESP_Settings.Objects[Player] = {}

    -- рисуем бокс
    local Box = Drawing.new("Square")
    Box.Size = Vector2.new(30, 30)
    Box.Position = Vector2.new(Pos.X - 15, Pos.Y - 15)
    Box.Color = ESP_Settings.Color
    Box.Thickness = 2
    Box.Filled = false
    table.insert(ESP_Settings.Objects[Player], Box)

    -- рисуем имя
    if ESP_Settings.ShowNames then
        local Name = Drawing.new("Text")
        Name.Text = Player.Name
        Name.Position = Vector2.new(Pos.X - 15, Pos.Y - 35)
        Name.Color = Color3.fromRGB(255, 255, 255)
        Name.Size = 14
        Name.Outline = true
        table.insert(ESP_Settings.Objects[Player], Name)
    end

    -- рисуем здоровье
    if ESP_Settings.ShowHealth and Player.Character:FindFirstChild("Humanoid") then
        local Health = Player.Character.Humanoid.Health
        local Text = Drawing.new("Text")
        Text.Text = math.floor(Health) .. " HP"
        Text.Position = Vector2.new(Pos.X - 15, Pos.Y + 20)
        Text.Color = Health > 50 and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        Text.Size = 12
        Text.Outline = true
        table.insert(ESP_Settings.Objects[Player], Text)
    end
end

-- главный цикл рендера
RunService.RenderStepped:Connect(function()
    -- очистка объектов мертвых игроков
    for player, objects in pairs(ESP_Settings.Objects) do
        if not player.Character or player.Character:FindFirstChild("Humanoid").Health <= 0 then
            for _, obj in pairs(objects) do pcall(function() obj:Remove() end) end
            ESP_Settings.Objects[player] = nil
        else
            DrawESP(player)
        end
    end
end)

