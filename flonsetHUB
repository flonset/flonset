-- ESP Logic
local function DrawESP(Player)
    if not ESP_Settings.Enabled or Player == LocalPlayer or not Player.Character then return end
    local Head = Player.Character:FindFirstChild("Head")
    if not Head then return end
    
    local Pos, OnScreen = Camera:WorldToViewportPoint(Head.Position)
    if not OnScreen then return end

    if ESP_Settings.Objects[Player] then
        for _, obj in pairs(ESP_Settings.Objects[Player]) do pcall(function() obj:Remove() end) end
    end
    ESP_Settings.Objects[Player] = {}

    local Box = Drawing.new("Square")
    Box.Size = Vector2.new(30, 30)
    Box.Position = Vector2.new(Pos.X - 15, Pos.Y - 15)
    Box.Color = ESP_Settings.Color
    Box.Thickness = 2
    Box.Filled = false
    table.insert(ESP_Settings.Objects[Player], Box)
    
    local Name = Drawing.new("Text")
    Name.Text = Player.Name
    Name.Position = Vector2.new(Pos.X - 15, Pos.Y - 35)
    Name.Color = Color3.fromRGB(255, 255, 255)
    Name.Size = 14
    Name.Outline = true
    table.insert(ESP_Settings.Objects[Player], Name)
end

RunService.RenderStepped:Connect(function()
    for player, objects in pairs(ESP_Settings.Objects) do
        if not player.Character or player.Character:FindFirstChild("Humanoid").Health <= 0 then
            for _, obj in pairs(objects) do pcall(function() obj:Remove() end) end
            ESP_Settings.Objects[player] = nil
        else
            DrawESP(player)
        end
    end
end)

-- Toggle Key G
local isVisible = true
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.G then
        isVisible = not isVisible
        MainFrame.Visible = isVisible
    end
end)
