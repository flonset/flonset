-- Логика плавного раскрытия (анимация через TweenService)
local isOpen = false
EspDropdown.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    
    -- Считаем реальную высоту в зависимости от количества элементов (4 элемента по ~32 пикселя + отступы)
    local targetHeight = isOpen and 150 or 0
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    TweenService:Create(EspContainer, tweenInfo, {Size = UDim2.new(1, -10, 0, targetHeight)}):Play()
    
    if isOpen then
        EspDropdown.Text = "  ▲  ESP Settings"
    else
        EspDropdown.Text = "  ▼  ESP Settings"
    end
end)
